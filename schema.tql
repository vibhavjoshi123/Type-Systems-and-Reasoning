# FLSA white-collar overtime exemption — the complete schema
#
# 29 USC § 213(a) exempts executive, administrative, professional, computer
# and outside-sales employees from overtime. 29 CFR Part 541 defines what
# each of those means. The structure is a five-way disjunction: an employee
# needs to satisfy only one category.
#
# What makes it a useful subject is the split inside it. Of the 29 tests in
# the rulebook, 19 are thresholds or lookups over stored values and a
# function settles them exactly. The other 10 have no closed form at all --
# "primary duty is management" (§ 541.100(a)(2)), "exercises discretion and
# independent judgment" (§ 541.202) -- and no function can be written for
# them, because § 541.2 is explicit that a job title establishes nothing and
# actual duties control. Duties are prose.
#
# Two design choices are worth noticing before reading on.
#
#   `job_description @card(0..1)` -- a missing description is schema-legal.
#   That is deliberate: with nothing on file the duty tests cannot be settled
#   either way, and a verdict must come back resting on a gap rather than
#   guessing.
#
#   Regulatory classifications live in DATA, on an `occupation` entity with a
#   multi-valued `classification`. So moving an occupation in or out of
#   § 541.3's categorical bar is a write, not a code change and not a schema
#   migration.
#
# Thresholds are the 2019 rule: $684/week (§ 541.600(a)) and $27.63/hour for
# computer employees (§ 213(a)(17)).

define

# ── attributes ───────────────────────────────────────────────────────
attribute emp_id, value string;
attribute name, value string;
attribute job_title, value string;
# 0..1 is load-bearing: a missing description is schema-legal, and is what
# produces a verdict that rests on a gap.
attribute job_description, value string;
attribute occupation_code, value string;
attribute classification, value string
    @values("categorically_nonexempt", "computer_occupation",
            "excluded_computer_role", "salary_test_exempt", "creative_field");
attribute annual_gross_volume, value double;
attribute fte, value double @range(0.0..1.0);
attribute hire_fire_authority, value boolean;
attribute recommendations_weighted, value boolean;
attribute weekly_salary, value double;
attribute hourly_rate, value double;
attribute salary_guaranteed, value boolean;
attribute duty_kind, value string
    @values("management", "office_nonmanual", "manual", "systems_analysis",
            "software_design", "os_programming", "making_sales",
            "advanced_knowledge", "creative", "routine_clerical",
            "help_desk", "hardware_repair", "teaching", "practice_of_law");
attribute duty_share, value double @range(0.0..1.0);
attribute offsite_days_per_week, value double @range(0.0..7.0);
attribute credential_level, value string
    @values("none", "associate", "bachelor", "master", "doctorate",
            "professional_license");
attribute credential_field, value string;

# ── entities ─────────────────────────────────────────────────────────
entity employer,
    owns name @key,
    owns annual_gross_volume @card(1),
    plays employment:employer;

entity employee,
    owns emp_id @key,
    owns name @card(1),
    owns job_title @card(1),
    owns job_description @card(0..1),
    owns hire_fire_authority @card(0..1),
    owns recommendations_weighted @card(0..1),
    owns weekly_salary @card(0..1),
    owns hourly_rate @card(0..1),
    owns salary_guaranteed @card(0..1),
    owns offsite_days_per_week @card(0..1),
    plays employment:employee,
    plays holds_occupation:worker,
    plays supervision:supervisor,
    plays duty_allocation:performer,
    plays credential_held:holder;

# The regulatory classification table — a reference entity, not an
# or-chain inside a function body.
entity occupation,
    owns occupation_code @key,
    owns name @card(1),
    owns classification @card(0..),
    plays holds_occupation:occupation;

entity duty,
    owns duty_kind @card(1),
    owns duty_share @card(1),
    plays duty_allocation:duty;

entity credential,
    owns credential_level @card(1),
    owns credential_field @card(1),
    plays credential_held:credential;

entity supervised_post,
    owns name @key,
    owns fte @card(1),
    plays supervision:supervised;

# ── relations ────────────────────────────────────────────────────────
relation employment,
    relates employer @card(1),
    relates employee @card(1);

relation holds_occupation,
    relates worker @card(1),
    relates occupation @card(1);

# n-ary: one relation carries the whole supervised span, not one edge each.
relation supervision,
    relates supervisor @card(1),
    relates supervised @card(1..);

relation duty_allocation,
    relates performer @card(1),
    relates duty @card(1..);

relation credential_held,
    relates holder @card(1),
    relates credential @card(1);

employee plays employment:employee @card(1);
employer plays employment:employer @card(0..);

# ── the determination, and its evidence ──────────────────────────────
#
# A verdict is only auditable if a reviewer can reconstruct it from the
# database alone, days later, without the run log. So the determination
# links what it relied on as ROLE PLAYERS rather than copying values: the
# employee, the exemption category it closed under, each prong that was
# settled, and each question that had to be admitted.
#
# 29 CFR 541.2 is the reason the admitted ones are recorded as first-class
# rather than omitted: a determination that rests on an unverified duty
# description is a different thing from one that does not, and the record
# has to say which.

attribute determination_id, value string;
attribute verdict, value string
    @values("exempt", "nonexempt", "needs_human_review");
attribute decided_at, value datetime;
attribute decided_by, value string;
attribute settled_how, value string
    @values("schema-function", "ask-model", "split", "admitted");
attribute prong_name, value string;
attribute prong_citation, value string;
attribute prong_held, value boolean;
attribute model_probability, value double @range(0.0..1.0);
attribute model_confidence, value double @range(0.0..1.0);
attribute step_order, value integer;
attribute full_trace, value string;

# One prong, as it was actually settled on this run.
entity prong_finding,
    owns prong_name @card(1),
    owns prong_citation @card(0..1),
    owns prong_held @card(1),
    owns settled_how @card(1),
    owns model_probability @card(0..1),
    owns model_confidence @card(0..1),
    owns step_order @card(1),
    plays determination:relied_on,
    plays determination:admitted;

relation determination,
    relates about @card(1),              # the employee
    relates relied_on @card(0..),        # every prong that was settled
    relates admitted @card(0..),         # the ones nobody could settle
    owns determination_id @key,
    owns verdict @card(1),
    owns decided_at @card(1),
    owns decided_by @card(1),
    owns full_trace @card(1);

employee plays determination:about @card(0..);

# ════════════════════════════════════════════════════════════════════
# THE 19 TESTS A FUNCTION CAN SETTLE
# ════════════════════════════════════════════════════════════════════

define

# ── enterprise coverage, 29 USC § 203(s)(1)(A)(ii) ───────────────────
fun enterprise_is_covered($e: employee) -> boolean:
  match
    employment (employer: $r, employee: $e);
    $r has annual_gross_volume $v;
    $v >= 500000.0;
  return check;

# ── categorical bars, 29 CFR § 541.3 ────────────────────────────────
fun is_categorically_nonexempt($e: employee) -> boolean:
  match
    holds_occupation (worker: $e, occupation: $o);
    $o has classification "categorically_nonexempt";
  return check;

# ── salary tests, § 541.600(a) and § 541.602(a) ──────────────────────
fun meets_salary_threshold($e: employee) -> boolean:
  match
    $e has weekly_salary $s;
    $s >= 684.0;
  return check;

fun paid_on_salary_basis($e: employee) -> boolean:
  match
    $e has salary_guaranteed true;
  return check;

# ── computer employees, 29 USC § 213(a)(17), § 541.400(b), § 541.401 ─
fun in_computer_occupation($e: employee) -> boolean:
  match
    holds_occupation (worker: $e, occupation: $o);
    $o has classification "computer_occupation";
  return check;

fun in_excluded_computer_role($e: employee) -> boolean:
  match
    holds_occupation (worker: $e, occupation: $o);
    $o has classification "excluded_computer_role";
  return check;

fun meets_computer_hourly_rate($e: employee) -> boolean:
  match
    $e has hourly_rate $h;
    $h >= 27.63;
  return check;

# ── executive, § 541.100(a)(3) and § 541.104 ─────────────────────────
# The unit § 541.104 counts in is full-time equivalents, not heads.
fun supervised_fte($e: employee) -> double:
  match
    supervision (supervisor: $e, supervised: $p);
    $p has fte $f;
  return sum($f);

fun directs_two_or_more_fte($e: employee) -> boolean:
  match
    let $total in supervised_fte($e);
    $total >= 2.0;
  return check;

fun has_hire_fire_authority($e: employee) -> boolean:
  match
    $e has hire_fire_authority true;
  return check;

fun recommendations_are_weighted($e: employee) -> boolean:
  match
    $e has recommendations_weighted true;
  return check;

# ── duty shares, § 541.700 ───────────────────────────────────────────
# Written for the one kind it is asked about rather than parameterised.
# A `string` parameter cannot bind an attribute — `$d has duty_kind $kind`
# declares $kind as both a Value and an Attribute:
#   [REP35] The variable 'kind' cannot be declared as both a 'Value' and
#           as an 'Attribute'
# and a generic version nothing else calls is not worth the workaround.
fun manual_share($e: employee) -> double:
  match
    duty_allocation (performer: $e, duty: $d);
    $d has duty_kind "manual", has duty_share $s;
  return sum($s);

fun primarily_non_manual($e: employee) -> boolean:
  match
    let $m in manual_share($e);
    $m < 0.5;
  return check;

# ── outside sales, § 541.500(a)(2) and § 541.502 ─────────────────────
fun customarily_works_offsite($e: employee) -> boolean:
  match
    $e has offsite_days_per_week $d;
    $d >= 2.0;
  return check;

# ── professional, § 541.301(d), § 541.302(a), § 541.303-304 ──────────
fun in_salary_exempt_profession($e: employee) -> boolean:
  match
    holds_occupation (worker: $e, occupation: $o);
    $o has classification "salary_test_exempt";
  return check;

fun in_recognized_creative_field($e: employee) -> boolean:
  match
    holds_occupation (worker: $e, occupation: $o);
    $o has classification "creative_field";
  return check;

# A disjunction of equalities rather than `$l in [...]`: the list form is
# not accepted for an attribute variable here.
fun holds_qualifying_credential($e: employee) -> boolean:
  match
    credential_held (holder: $e, credential: $c);
    $c has credential_level $l;
    { $l == "bachelor"; } or { $l == "master"; } or
      { $l == "doctorate"; } or { $l == "professional_license"; };
  return check;

# ── has a filed description at all, § 541.2 ─────────────────────────
# Not a test of exempt status — a test of whether the duty judgement can
# be made. 29 CFR § 541.2 is explicit that a title does not establish
# exempt status and actual duties control, so with no description on file
# the duty prongs cannot be settled either way.
fun has_job_description($e: employee) -> boolean:
  match
    $e has job_description $d;
  return check;
